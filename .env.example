# Telegram API credentials
# Obtain from https://my.telegram.org → API Development Tools → Create application
# Keep these secret — anyone with these plus your phone number can authenticate as you.
TG_VOICE_API_ID=1234567
TG_VOICE_API_HASH=00000000000000000000000000000000

# Your phone number in E.164 format (international, no spaces)
# Example: +15551234567  (US)  or  +79161234567  (Russia)
TG_VOICE_PHONE=+10000000000

# Path to the Telethon session file.
# Dev default is ./.local/userbot.session (gitignored).
# Production systemd uses /var/lib/tg-voice-transcriber/userbot.session (see systemd unit, Phase 6).
TG_VOICE_SESSION_PATH=.local/userbot.session

# Log level: DEBUG / INFO / WARNING / ERROR
TG_VOICE_LOG_LEVEL=INFO

# ── VPN Trial Finder / Harvester (v1.2 / v1.3) ─────────────────────────────
# The finder/harvester run on a SEPARATE account from the main userbot.
# Leave TG_VOICE_FINDER_PHONE empty to disable the finder entirely.
TG_VOICE_FINDER_PHONE=
TG_VOICE_FINDER_SESSION_PATH=.local/finder.session
TG_VOICE_FINDER_DB_PATH=.local/finder.db

# Title of the Telegram folder (chat-list tab) that collected VPN bots are
# filed into. Matched case-insensitively, then pinned by folder id so a later
# rename won't break anything. Set this to your EXACT current folder name.
TG_VOICE_FINDER_FOLDER_TITLE=10+ days vpn

# LLM keys for offer judging (Groq primary, OpenRouter fallback). At least one
# is required for the finder/harvester to judge offers.
# TG_VOICE_GROQ_API_KEY=gsk_...            # comma-separated for a rotation pool
# TG_VOICE_OPENROUTER_API_KEYS=sk-or-v1-...  # comma-separated; enables failover
